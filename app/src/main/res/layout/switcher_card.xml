<?xml version="1.0" encoding="utf-8"?>
<view xmlns:android="http://schemas.android.com/apk/res/android"
    class="dev.ranjan.tvrecents.SwitcherCard"
    android:layout_width="160dp"
    android:layout_height="90dp"
    android:layout_marginHorizontal="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/switcher_card_bg"
        android:clipToOutline="true"
        android:outlineProvider="background">


    <ImageView
        android:id="@+id/card_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/card_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/card_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
    </FrameLayout>

    <!-- Per-side margins: a negative layout_margin shorthand is silently ignored. -->
    <FrameLayout
        android:id="@+id/card_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="-5dp"
        android:layout_marginTop="-5dp"
        android:layout_marginRight="-5dp"
        android:layout_marginBottom="-5dp"
        android:importantForAccessibility="noHideDescendants"
        android:visibility="invisible">

        <View
            android:id="@+id/card_halo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/card_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp" />
    </FrameLayout>
</view>
